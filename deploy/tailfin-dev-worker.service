[Unit]
# The simulation engine, on dev (OPS-09).
#
# The process ADR-0019 defined: it runs the tick loop, drains `world_event`, and
# serves nothing but a loopback health endpoint. It is the first place a Tailfin
# worker has ever run, which is the point — production must not be where the
# engine's operational behaviour gets learned.
Description=Tailfin simulation worker (dev environment)
Documentation=https://github.com/simmeh024/tailfinsim/blob/main/deploy/README.md
After=network-online.target tailfin-db-tunnel.service
Wants=network-online.target

# Not `Requires=postgresql.service` like the web units: there is no Postgres on
# this node. The database is reached through the tunnel, and without it this
# process can do nothing at all — so the dependency is hard, and systemd stops
# the worker when the tunnel stops rather than leaving it logging failures at
# 1 Hz.
Requires=tailfin-db-tunnel.service

[Service]
Type=simple
User=tailfin
Group=tailfin

# Its own checkout, not the web node's. #193 wants the nodes independently
# deployable, and sharing a directory across a machine boundary is not an option
# here anyway.
WorkingDirectory=/srv/tailfin-dev-worker/packages/server
ExecStart=/usr/bin/node dist/worker.js

Restart=always
RestartSec=5s

# SIGTERM, and longer than the web unit's 15s on purpose. The worker's shutdown
# waits for a tick that is already inside a transaction to finish before it
# closes the pool — that wait is the difference between a clean stop and an event
# applied halfway. `worker.ts` gives up on its own at 15s, so systemd must not
# reach for SIGKILL before then.
KillSignal=SIGTERM
TimeoutStopSec=30s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=tailfin-dev-worker

# Bounded from the start rather than after the first incident (#175, and the
# risk #188 names). This node has two cores and the worker is alone on it today,
# but the engine is the part of Tailfin whose cost is unknown — it has never run
# anywhere — and an unbounded loop discovering that on a box someone is watching
# is worth avoiding for the price of one line.
CPUQuota=150%
MemoryMax=1G

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true

# No public interface, and egress denied by default. `worker.ts` binds 127.0.0.1
# and refuses to read HOST; this says the same at the unit level, so a future
# `WORKER_HEALTH_HOST` cannot quietly publish the endpoint. `IPAddressDeny=any`
# also blocks *outbound*, which is the posture ADR-0012 wanted — the DB is a
# localhost tunnel and the worker originated nothing else.
#
# M8-02's nightly FX refresh is the one exception: it reads USD rates from a
# Cloudflare-fronted provider (open.er-api.com, or v6.exchangerate-api.com when a
# key is set — both in ADR-0012). `IPAddressAllow` is additive, so the lines below
# open **only** Cloudflare's published ranges on top of the default deny; DNS is
# the localhost systemd-resolved stub (127.0.0.53), already covered by `localhost`.
# Update these if Cloudflare republishes its ranges (cloudflare.com/ips).
IPAddressAllow=localhost
IPAddressDeny=any
# Cloudflare IPv4 (cloudflare.com/ips-v4)
IPAddressAllow=173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
# Cloudflare IPv6 (cloudflare.com/ips-v6)
IPAddressAllow=2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32

[Install]
WantedBy=multi-user.target
