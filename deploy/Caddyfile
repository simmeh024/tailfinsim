# Installed at /etc/caddy/Caddyfile. Caddy obtains and renews Let's Encrypt
# certificates automatically. DNS must already resolve to this host or the ACME
# challenge fails — see docs/deploy.md.
#
# Two things here are the way they are because Caddy rejected the alternatives
# on a real box (verified against Caddy 2.11.4 from the official apt repo):
#
#   1. No global `email` directive, and the override below is a **glob**.
#      `{ email {$ACME_EMAIL} }` fails to parse when the variable is unset —
#      `email` cannot take an empty argument, and Caddy's packaged systemd unit
#      does not read /etc/default/caddy. A literal `import` of a single file
#      also fails when that file is absent ("File to import not found"); only a
#      glob tolerates matching nothing.
#
#   2. Logs go to stdout, not to a file. Caddy's packaged unit runs with
#      ProtectSystem=full and ReadWritePaths=/var/lib/caddy, so writing to
#      /var/log/caddy is denied and the service refuses to start. journald
#      captures stdout, so `journalctl -u caddy -f` is the way to read these.
#
# Certificates issue fine with no contact address; you only forgo expiry
# notification emails. To add one, drop a file in /etc/caddy/conf.d/ ending in
# .caddyfile containing:
#
#     { email you@example.com }
#
# Keeping it off-repo avoids committing a personal address to a public
# repository.
import /etc/caddy/conf.d/*.caddyfile

tailfinsim.com {
	encode zstd gzip

	# Everything is one origin on purpose: same-origin means M0-11's session
	# cookies work with SameSite=Lax and no CORS. See docs/deploy.md.
	reverse_proxy 127.0.0.1:3000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format json
	}
}

www.tailfinsim.com {
	redir https://tailfinsim.com{uri} permanent
}
