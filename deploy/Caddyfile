# Caddy obtains and renews Let's Encrypt certificates automatically. DNS must
# already resolve to this host or the ACME challenge fails — see docs/deploy.md.

{
	email {$ACME_EMAIL}
}

tailfinsim.com {
	encode zstd gzip

	# Everything is one origin on purpose: same-origin means M0-11's session
	# cookies work with SameSite=Lax and no CORS. See docs/deploy.md.
	reverse_proxy server:3000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format json
	}
}

www.tailfinsim.com {
	redir https://tailfinsim.com{uri} permanent
}
