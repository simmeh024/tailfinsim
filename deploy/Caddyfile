# Installed at /etc/caddy/Caddyfile. Caddy obtains and renews Let's Encrypt
# certificates automatically. DNS must already resolve to this host or the ACME
# challenge fails — see docs/deploy.md.
#
# Two things here are the way they are because Caddy rejected the alternatives
# on a real box (verified against Caddy 2.11.4 from the official apt repo):
#
#   1. No global `email` directive. `{ email {$ACME_EMAIL} }` fails to parse
#      when the variable is unset — `email` cannot take an empty argument, and
#      Caddy's packaged systemd unit does not read /etc/default/caddy.
#
#   2. Logs go to stdout, not to a file. Caddy's packaged unit runs with
#      ProtectSystem=full and ReadWritePaths=/var/lib/caddy, so writing to
#      /var/log/caddy is denied and the service refuses to start. journald
#      captures stdout: `journalctl -u caddy -f`.
#
# ---------------------------------------------------------------------------
# The two import styles below are different **on purpose**.
#
#   glob    (`conf.d/*.caddyfile`)  tolerates matching nothing → fails OPEN.
#   literal (`dev-auth.caddyfile`)  errors if absent            → fails CLOSED.
#
# The optional ACME contact address may safely be missing, so it is a glob. The
# dev site's credentials may NOT safely be missing — if that file disappeared
# and the import were a glob, dev would silently serve unauthenticated. Using a
# literal import means Caddy refuses to start instead, which is the behaviour
# you want from an auth gate.
# ---------------------------------------------------------------------------

# Optional. Add /etc/caddy/conf.d/acme.caddyfile containing `{ email you@x }`
# for certificate expiry notices. Kept off-repo so no personal address is
# committed to a public repository.
import /etc/caddy/conf.d/*.caddyfile

# ---------------------------------------------------------------------------
# Production — the public front door. Currently the holding page.
# ---------------------------------------------------------------------------
tailfinsim.com {
	encode zstd gzip

	# Everything is one origin on purpose: same-origin means M0-11's session
	# cookies work with SameSite=Lax and no CORS. See docs/deploy.md.
	reverse_proxy 127.0.0.1:3000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format json
	}
}

www.tailfinsim.com {
	redir https://tailfinsim.com{uri} permanent
}

# ---------------------------------------------------------------------------
# Dev — where work in progress is looked at before it reaches the front door.
# Separate checkout, separate database, separate port. Password protected, and
# excluded from search engines.
# ---------------------------------------------------------------------------
dev.tailfinsim.com {
	encode zstd gzip

	# Credentials live off-repo in /etc/caddy/dev-auth.caddyfile:
	#     basic_auth { <user> <bcrypt-hash> }
	# Generate a hash with: caddy hash-password
	# A *literal* import, so a missing file stops Caddy rather than exposing
	# dev without authentication. See the note at the top of this file.
	import /etc/caddy/dev-auth.caddyfile

	reverse_proxy 127.0.0.1:3001

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Basic auth already means crawlers get a 401, but this covers the
		# case where auth is ever relaxed for a demo.
		X-Robots-Tag "noindex, nofollow, noarchive"
		-Server
	}

	log {
		output stdout
		format json
	}
}
