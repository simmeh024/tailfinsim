# Installed at /etc/caddy/Caddyfile. Caddy obtains and renews Let's Encrypt
# certificates automatically. DNS must already resolve to this host or the ACME
# challenge fails — see docs/deploy.md.
#
# There is deliberately no global `email` directive here. An earlier version used
#
#     { email {$ACME_EMAIL} }
#
# which fails to parse whenever the variable is unset: Caddy's `email` cannot
# take an empty argument, and Caddy's packaged systemd unit does not read
# /etc/default/caddy — so it was unset at runtime and broke startup. Verified
# against Caddy 2.11.4 with `caddy validate`.
#
# Certificates issue fine without a contact address; you only forgo expiry
# notification emails. To add one, create /etc/caddy/local.caddyfile on the
# server containing:
#
#     { email you@example.com }
#
# Keeping it off-repo avoids committing a personal address to a public
# repository. The import below tolerates the file being absent.
import /etc/caddy/local.caddyfile

tailfinsim.com {
	encode zstd gzip

	# Everything is one origin on purpose: same-origin means M0-11's session
	# cookies work with SameSite=Lax and no CORS. See docs/deploy.md.
	reverse_proxy 127.0.0.1:3000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output file /var/log/caddy/tailfinsim.log
		format json
	}
}

www.tailfinsim.com {
	redir https://tailfinsim.com{uri} permanent
}
