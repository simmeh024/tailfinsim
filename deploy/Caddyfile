# Installed at /etc/caddy/Caddyfile. Caddy obtains and renews Let's Encrypt
# certificates automatically. DNS must already resolve to this host or the ACME
# challenge fails — see docs/deploy.md.
#
# Two things here are the way they are because Caddy rejected the alternatives
# on a real box (verified against Caddy 2.11.4 from the official apt repo):
#
#   1. No global `email` directive. `{ email {$ACME_EMAIL} }` fails to parse
#      when the variable is unset — `email` cannot take an empty argument, and
#      Caddy's packaged systemd unit does not read /etc/default/caddy.
#
#   2. Logs go to stdout, not to a file. Caddy's packaged unit runs with
#      ProtectSystem=full and ReadWritePaths=/var/lib/caddy, so writing to
#      /var/log/caddy is denied and the service refuses to start. journald
#      captures stdout: `journalctl -u caddy -f`.
#
# ---------------------------------------------------------------------------
# Dev used to sit behind HTTP basic auth, imported from a literal path so that a
# missing credentials file stopped Caddy rather than serving dev open. That gate
# was removed once Google sign-in (M0-11) reached dev: two password prompts to
# look at one page, the first of which the browser re-asked on every refresh.
#
# What guards dev now is the application: `RequireSession` in the client and
# `requireAuth` / `requireAdmin` on the server. The `X-Robots-Tag` below is
# therefore no longer belt-and-braces — it is the only thing discouraging
# indexing, so leave it in place.
#
# `ALLOW_REGISTRATION=true` on dev is a **deliberate choice**, confirmed
# 2026-08-18: it is how people get invited to look at work in progress, and the
# only way to exercise the sign-up path itself. So dev is knowingly an open
# Google sign-up on a public hostname — the subdomain is discoverable through
# certificate transparency whatever the robots header says.
#
# That is the right trade for a pre-launch preview environment with disposable
# data. It stops being the right trade the moment dev holds anything that matters,
# and the front door is a different question entirely: production defaults to
# `ALLOW_REGISTRATION=false` and stays that way until launch.
# ---------------------------------------------------------------------------

# Optional. Add /etc/caddy/conf.d/acme.caddyfile containing `{ email you@x }`
# for certificate expiry notices. Kept off-repo so no personal address is
# committed to a public repository.
import /etc/caddy/conf.d/*.caddyfile

# Browser-side policy is owned here, once, so static assets, API responses and
# error responses cannot drift apart. TAILFIN_CSP_HEADER exists solely for the
# first rollout: set it to Content-Security-Policy-Report-Only in Caddy's
# systemd environment, exercise the real dev sign-in/avatar journey, then
# remove the override to return to the enforced default. See deploy/README.md.
(tailfin_security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), usb=(), web-share=(), xr-spatial-tracking=()"
		{$TAILFIN_CSP_HEADER:Content-Security-Policy} "default-src 'self'; script-src 'self'; style-src 'self' 'sha256-ftYZ6VWMqcx4KWcJ2/G2tKyA+X9oEaozaSrupOVb8KM='; img-src 'self' data: https://lh3.googleusercontent.com; connect-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'none'; object-src 'none'"
		-Server
	}
}

# ---------------------------------------------------------------------------
# Production — the public front door. Currently the holding page.
# ---------------------------------------------------------------------------
{$TAILFIN_PRODUCTION_SITE:tailfinsim.com} {
	encode zstd gzip

	# Everything is one origin on purpose: same-origin means M0-11's session
	# cookies work with SameSite=Lax and no CORS. See docs/deploy.md.
	reverse_proxy {$TAILFIN_PRODUCTION_UPSTREAM:127.0.0.1:3000}

	import tailfin_security_headers

	log {
		output stdout
		format json
	}
}

{$TAILFIN_WWW_SITE:www.tailfinsim.com} {
	redir https://tailfinsim.com{uri} permanent
}

# ---------------------------------------------------------------------------
# Dev — where work in progress is looked at before it reaches the front door.
# Separate checkout, separate database, separate port. Guarded by Google sign-in
# rather than a password prompt, and excluded from search engines.
# ---------------------------------------------------------------------------
{$TAILFIN_DEV_SITE:dev.tailfinsim.com} {
	encode zstd gzip

	reverse_proxy {$TAILFIN_DEV_UPSTREAM:127.0.0.1:3001}

	header {
		# Now the only thing keeping dev out of search results: there is no
		# longer a 401 in front of it. Do not remove.
		X-Robots-Tag "noindex, nofollow, noarchive"
	}

	import tailfin_security_headers

	log {
		output stdout
		format json
	}
}
