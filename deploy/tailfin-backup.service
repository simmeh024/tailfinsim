[Unit]
Description=Nightly Postgres backup for Tailfin
Documentation=https://github.com/simmeh024/tailfinsim/blob/main/deploy/README.md
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot

# Runs as postgres so peer auth on the local socket applies and no password is
# needed anywhere. The script reads databases, writes to BACKUP_DIR, and reads
# the DreamObjects credentials from /etc/tailfin (read-only under
# ProtectSystem=strict, which is all it needs).
User=postgres
Group=postgres

# Installed by hand from deploy/backup.sh, **not** run out of the checkout.
#
# It used to be /srv/tailfin/deploy/backup.sh, which quietly tied the backup
# system to how current the production checkout happened to be: a box sitting on
# an old commit kept running that commit's backup script. Backups are the one
# thing that must not stop improving because a deploy has not happened.
#
# Install it the same way as this unit and the Caddyfile — see deploy/README.md.
ExecStart=/usr/local/sbin/tailfin-backup

# A hung dump must not block tomorrow's run.
TimeoutStartSec=1800

StandardOutput=journal
StandardError=journal
SyslogIdentifier=tailfin-backup

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# The only path it may write to.
ReadWritePaths=/var/backups/tailfin

[Install]
WantedBy=multi-user.target
