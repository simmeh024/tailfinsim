# Copy to `.env` and adjust. `.env` is gitignored and must never be committed.
# The full documented set, including production-only values, is in docs/deploy.md.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Must match the credentials in docker-compose.yml for local development.
DATABASE_URL=postgres://tailfin:tailfin_dev@127.0.0.1:5432/tailfin

# Optional — override the docker-compose defaults.
# POSTGRES_USER=tailfin
# POSTGRES_PASSWORD=tailfin_dev
# POSTGRES_DB=tailfin
# POSTGRES_PORT=5432

# Maximum connections in the server's pool. Defaults to 10.
# DATABASE_POOL_MAX=10

# How long to wait for a TCP connection to Postgres, in milliseconds. Defaults
# to 5000. `pg`'s own default is 0 — wait forever — which makes /healthz hang
# instead of answering 503 when the database is unreachable, and deploy.sh reads
# /healthz to decide whether a release came up.
# DATABASE_CONNECT_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development

# Pino log level: fatal | error | warn | info | debug | trace
# LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Access
# ---------------------------------------------------------------------------
# Whether new players may create accounts. Defaults to false — the world is not
# open, and a signup route that is public by default gets found before you are
# ready. M0-11 must honour this on whatever registration endpoint it adds.
# Accepts true/false or 1/0; anything else throws rather than being guessed.
# ALLOW_REGISTRATION=false

# ---------------------------------------------------------------------------
# Google OAuth (M0-11) — see docs/adr/0004-google-oauth.md
# ---------------------------------------------------------------------------
# From a Google Cloud OAuth 2.0 "Web application" client. Authorised redirect
# URI must match PUBLIC_ORIGIN exactly, so dev and production need their own
# entries (ideally their own clients):
#     https://tailfinsim.com/api/auth/google/callback
#     https://dev.tailfinsim.com/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Signs session cookies. 32+ random bytes: openssl rand -base64 48
# Rotating it invalidates every session.
# SESSION_SECRET=

# The absolute origin this instance is reached on. The OAuth redirect URI is
# derived from it, so it must match what Google has registered exactly —
# scheme, host and port, no trailing slash. Defaults to http://localhost:3000.
# It also decides whether cookies are marked Secure: https origins only.
# PUBLIC_ORIGIN=http://localhost:3000

# How long a session lasts, in hours. Defaults to 720 (30 days).
# SESSION_TTL_HOURS=720

# All three of GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET and SESSION_SECRET must be
# set together, or all left unset. Setting only some of them is refused at boot:
# a half-configured setup looks like working sign-in and fails at the callback,
# after the player has already been sent to Google.
