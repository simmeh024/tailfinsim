# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Test / coverage
coverage/
.vitest/
.e2e-types/
playwright-report/
test-results/
post-deploy-results/
e2e/.auth/

# Environment — never commit secrets (M0-05: connection config from env)
.env
.env.*
!.env.example

# Keys and credentials. A private key was once committed here from an
# OpenStack keypair download landing in the repo root, so this is not
# hypothetical — keys belong in ~/.ssh, never in a checkout.
*.pem
*.key
*.ppk
*.p12
*.pfx
id_rsa*
id_ecdsa*
id_ed25519*
*.jks
.ssh/

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Local Postgres data (docker-compose volume fallback)
.postgres-data/

# Downloaded reference datasets (M1-01). Third-party, ~17 MB, republished
# weekly — the checksum in `dataset_version` is what pins a build, not a copy
# of the CSVs in git.
.cache/

# Generated distance matrix (M1-04) — 38 MB, derived from the airport table.
packages/server/data/generated/
